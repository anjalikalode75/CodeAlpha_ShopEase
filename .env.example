# ==========================================
# ShopEase Environment Configuration Template
# Copy this file to .env in local environments
# NEVER commit real credentials to version control
# ==========================================

# Server Configuration
NODE_ENV=development
PORT=5000

# Database Configuration (Local MongoDB or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/shopease

# Authentication & Security
JWT_SECRET=super_secret_jwt_key_replace_with_strong_random_string_in_production
JWT_EXPIRES_IN=7d
COOKIE_EXPIRES_DAYS=7

# Frontend Client URL (For CORS & Cookie handling)
CLIENT_URL=http://localhost:5173

# Admin Seeding (Used by scripts/seed.js)
ADMIN_NAME=Admin User
ADMIN_EMAIL=admin@shopease.com
ADMIN_PASSWORD=AdminPassword123!
